# Public site URL used for canonical links, sitemap and Open Graph.
# Optional on Vercel: falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: a form endpoint that accepts JSON POSTs (Formspree, Basin, Web3Forms...).
# When unset, the enquiry form opens WhatsApp with the details pre-filled.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
